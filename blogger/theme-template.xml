<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>

  <!-- 1. 구글 서치 콘솔 소유확인 (2026-09-23 확인 완료)
       ★ 지우지 마세요. 이 줄이 없으면 서치콘솔이 소유확인을 잃고,
         색인 상태·검색어 통계를 더 이상 볼 수 없게 됩니다. -->
  <meta content='T5-b2O5_rlIeXmMY3Y5mZFBKYJjL62T3-csS10KZMuE' name='google-site-verification'/>

  <!-- 2. 네이버 서치 어드바이저 소유확인 (2026-09-23 확인 완료) ★ 지우지 마세요 -->
  <meta content='f342bc4bc835c10355787bcbc737a96283d5b2ac' name='naver-site-verification'/>

  <!-- 3. 애드센스 (자동광고: 양쪽 사이드 레일 광고도 이 코드로 표시됨) -->
  <script async='async' crossorigin='anonymous' expr:src='&quot;https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=@@OIL_AD_CLIENT@@&quot;'/>

  <!-- 4. 아로스 애드센스 무효트래픽 방지코드 -->
  <script>
    window.redirectTarget = &quot;https://letsdoooit.com&quot;;
  </script>
  <script src='https://cdn.jsdelivr.net/gh/abaeksite/aros_adsense_blocker@main/aros_adsense_blocker_v7-1.js'/>

<!-- Open Graph (카톡·페이스북에 링크를 보냈을 때 보이는 카드)
     og:image 가 없으면 카톡이 본문에서 아무 그림이나 긁어다 잘라 보여준다.
     카톡 큰 카드는 가로세로 1.91:1 이라 1200x630 짜리를 따로 만들어 지정한다
     (img/og.jpg - 띠를 가운데 두고 위아래를 같은 색으로 채운 그림).
     ★ 주소를 여기 박아두지 말 것. 그림을 옮길 때 이것만 남아
       카톡에 이미지가 안 나왔던 적이 있다(2026-09-23).
     글 페이지에서는 제목을 그 글 제목으로 바꿔준다 - 공유했을 때
     전부 같은 제목으로 뜨면 무슨 글인지 알 수가 없다. -->
<b:if cond='data:blog.pageType == &quot;item&quot;'>
  <meta expr:content='data:blog.pageName + &quot; - 주유소찾기&quot;' property='og:title'/>
  <meta content='article' property='og:type'/>
<b:else/>
  <meta content='주유소찾기 - 다 따져서 제일 싼 주유소' property='og:title'/>
  <meta content='website' property='og:type'/>
</b:if>
<meta content='기름값만 싼 곳 말고, 가는 거리까지 계산해서 진짜 돈이 남는 주유소를 찾아드립니다. 전국 1만여 곳 실제 판매가, 매일 갱신.' property='og:description'/>
<meta expr:content='data:blog.url' property='og:url'/>
<meta content='주유소찾기' property='og:site_name'/>
<meta content='@@OIL_IMG_URL@@og.jpg' property='og:image'/>
<meta content='1200' property='og:image:width'/>
<meta content='630' property='og:image:height'/>
<meta content='주유소찾기 - 다 따져서 제일 싼 주유소를 찾아드립니다' property='og:image:alt'/>

<!-- Twitter -->
<meta content='summary_large_image' name='twitter:card'/>
<meta content='주유소찾기 - 다 따져서 제일 싼 주유소' name='twitter:title'/>
<meta content='기름값만 싼 곳 말고, 가는 거리까지 계산해서 진짜 돈이 남는 주유소를 찾아드립니다.' name='twitter:description'/>
<meta content='@@OIL_IMG_URL@@og.jpg' name='twitter:image'/>

<meta content='전국 주유소 1만여 곳의 실제 판매가로 우리 동네 기름값을 비교합니다. 같은 동네 안에서도 수백 원 차이가 나는 곳이 있습니다. 매일 갱신됩니다.' name='description'/>
<meta content='width=device-width,initial-scale=1.0' name='viewport'/>
<link href='https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css' rel='stylesheet'/>
<b:include data='blog' name='all-head-content'/>
<title><data:blog.pageTitle/></title>

<b:skin><![CDATA[
/* 주유소찾기 - 블로그스팟 전용 테마 (scripts/build_theme.py 로 자동 생성) */
/*@@OIL_CSS@@*/
]]></b:skin>
</head>

<body>
<header class='oil-header'>
  <a class='oil-hero-link' expr:href='data:blog.homepageUrl'>
    <picture>
      <source srcset='@@OIL_IMG_URL@@hero.webp' type='image/webp'/>
      <img alt='주유소찾기 - 기름값과 실제 이동거리를 다 따져서 제일 싼 주유소를 찾아드립니다' class='oil-hero-img' height='452' src='@@OIL_IMG_URL@@hero.jpg' width='1200'/>
    </picture>
  </a>
</header>

<nav class='oil-tabs' id='oil-tabs'>
  <ul><li><a class='active' href='/'>우리 동네</a></li></ul>
</nav>

<!-- 화면이 그려지는 자리 (홈 / 동네 상세 / 계산기) -->
<!-- 자체 닫힘(<div/>)으로 쓰면 브라우저가 '안 닫힌 div'로 읽어 뒤 내용이 전부 이 안으로 들어간다.
     블로그스팟은 알아서 닫아주지만, 미리보기가 깨지므로 명시적으로 닫는다. -->
<div id='oil-root'></div>

<!-- 일반 블로그 글 (앱 화면에서는 숨김) -->
<div class='oil-blog-wrap'>
<b:section class='main' id='main' showaddelement='no'>
  <b:widget id='Blog1' locked='true' title='블로그 게시물' type='Blog' version='1'>
    <b:widget-settings>
      <b:widget-setting name='showDateHeader'>false</b:widget-setting>
      <b:widget-setting name='showShareButtons'>false</b:widget-setting>
      <b:widget-setting name='showAuthor'>false</b:widget-setting>
      <b:widget-setting name='showTimestamp'>false</b:widget-setting>
      <b:widget-setting name='showLabels'>false</b:widget-setting>
      <b:widget-setting name='showCommentLink'>false</b:widget-setting>
      <b:widget-setting name='showInlineAds'>false</b:widget-setting>
      <b:widget-setting name='showReactions'>false</b:widget-setting>
      <b:widget-setting name='showBacklinks'>false</b:widget-setting>
      <b:widget-setting name='showLocation'>false</b:widget-setting>
      <b:widget-setting name='showAuthorProfile'>false</b:widget-setting>
      <b:widget-setting name='postsPerAd'>1</b:widget-setting>
      <b:widget-setting name='style.layout'>1x1</b:widget-setting>
    </b:widget-settings>
    <b:includable id='main' var='top'>
      <div class='blog-posts hfeed'>
        <b:loop values='data:posts' var='post'>
          <div class='post-outer'>
            <b:include data='post' name='post'/>
          </div>
        </b:loop>
      </div>
    </b:includable>
    <b:includable id='post' var='post'>
      <div class='post hentry' itemprop='blogPost' itemscope='itemscope' itemtype='http://schema.org/BlogPosting'>
        <b:if cond='data:post.title'>
          <h3 class='post-title entry-title' itemprop='name'>
            <b:if cond='data:post.link or (data:post.url and data:blog.url != data:post.url)'>
              <a expr:href='data:post.link ? data:post.link : data:post.url'><data:post.title/></a>
            <b:else/>
              <data:post.title/>
            </b:if>
          </h3>
        </b:if>
        <div class='post-body entry-content' expr:id='&quot;post-body-&quot; + data:post.id' itemprop='articleBody'>
          <data:post.body/>
          <div style='clear: both;'/>
        </div>
      </div>
    </b:includable>
  </b:widget>
</b:section>
</div>

<footer class='oil-footer'>
  <!-- 함께 보는 사이트. 모든 화면 맨 아래에 붙는다.
       ★ 그림을 못 받아오면 그 칸이 스스로 사라진다(onerror). 깨진 그림과
         덩그러니 남은 링크를 보여주는 것보다 아예 없는 편이 낫다.
       그림은 scripts/build_images.py 가 assets/ 원본에서 만든다. -->
  <div class='oil-sister'>
    <div class='oil-sister-t'>함께 보면 좋은 사이트</div>
    <div class='oil-sister-row'>
      <a class='oil-sister-a' href='https://16story-003.letsdoooit.com/?m=0' rel='noopener' target='_blank'>
        <img alt='정부지원금찾기 - 못 받은 지원금이 있는지 확인해보세요' onerror='this.parentNode.remove()' src='@@OIL_IMG_URL@@promo-gov.jpg'/>
        <span>나만 몰라 놓쳤던<br/>정부지원금 찾기</span>
      </a>
      <a class='oil-sister-a' href='https://16story-004.letsdoooit.com' rel='noopener' target='_blank'>
        <img alt='24시 심야약국찾기 - 지금 문 연 약국을 찾아보세요' onerror='this.parentNode.remove()' src='@@OIL_IMG_URL@@promo-pharm.jpg'/>
        <span>지금 문 연 24시 약국 찾기</span>
      </a>
    </div>
  </div>
  <div><b>주유소찾기</b>한국석유공사 오피넷이 공개하는 전국 주유소 판매가격을 바탕으로 정보 제공을 목적으로 운영됩니다.<br/>
  실제 판매가는 주유소 사정에 따라 다를 수 있으니 방문 전 확인하시기 바랍니다.</div>
</footer>

<script>
//<![CDATA[
/*@@OIL_CONFIG_START@@*/
window.OIL_CONFIG = {
  listPageUrl: '/',
  areaPageUrl: '/p/area.html',
  calcPageUrl: '/p/calc.html',
  reportLabelUrl: '/search/label/기름값리포트',
  dataBaseUrl: '@@OIL_DATA_URL@@',
  adClient: '@@OIL_AD_CLIENT@@',
  adSlot: '@@OIL_AD_SLOT@@',
  /* 카카오맵 장소검색. 비어 있으면 우리 데이터(읍면동·시군구·주유소 이름)로만 찾는다.
     SDK 는 검색창을 실제로 쓸 때 그때 불러온다 - 안 쓰는 사람은 내려받지 않는다. */
  kakaoKey: '@@OIL_KAKAO_KEY@@',
  /* 길찾기(실제 도로거리). naviProxy 가 있으면 그쪽으로 보내고 키는 담지 않는다.
     REST 키는 도메인 제한을 걸 수 없어, 공개 전에는 반드시 naviProxy 를 채워야 한다. */
  naviProxy: '@@OIL_NAVI_PROXY@@',
  naviKey: '@@OIL_NAVI_KEY@@'
